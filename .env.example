# Copy to .env for local development. Never commit .env.
# Contact email sent to the SEC in the User-Agent (required by their fair-access policy).
SEC_CONTACT_EMAIL=
# Optional: an OpenAI-compatible API key and endpoint for analysis (e.g. Groq).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
